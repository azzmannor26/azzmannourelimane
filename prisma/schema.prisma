// Define the PostgreSQL database connection configuration
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Define the Prisma client generator configuration
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["referentialActions"]
}

// Your existing models and enums
model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  phone       String
  firstLogin  Boolean?  @default(false)
  status      UserStatus @default(INACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  role        RoleName  @default(USER)
  
  // Add relation field for comments
  comments    Comment[] // A user can have multiple comments
}

model Blog {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  status    Status    @default(ACTIVE)
  
  // Add reciprocal relation for comments
  comments  Comment[] // A blog can have multiple comments
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  userId    Int
  blogId    Int

  // Relations
  user      User     @relation(fields: [userId], references: [id])
  blog      Blog     @relation(fields: [blogId], references: [id])
}

// Enum definition for Status
enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  USER
}
